{
  "name": "h3-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Ride-hailing dispatch simulator on Uber's H3 hexagonal grid: nearest-driver search by expanding rings, surge pricing per cell and a live map.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "h3-js": "^4.5.0",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
